# Groq API Key (obtain from console.groq.com)
GROQ_API_KEY=

# Gemini API Key (obtain from aistudio.google.com)
GEMINI_API_KEY=

# ElevenLabs API Key (obtain from elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Video settings
VIDEO_CRF=18
AUDIO_CODEC=aac
AUDIO_BITRATE=192k
OUTPUT_WIDTH=2160
OUTPUT_HEIGHT=3840

# Logging
LOG_LEVEL=INFO

# Gemini network limits (optional, seconds; 0 = no limit).
# GEMINI_FILE_PROCESSING_TIMEOUT: max wait for an uploaded clip to leave PROCESSING
#   (original pipeline default 600; Promo V3 Step 2 default 300).
# GEMINI_HTTP_TIMEOUT: per-request HTTP timeout of the Gemini client
#   (original pipeline default 600; Promo V3 Step 2 default 300).
# GEMINI_FILE_PROCESSING_TIMEOUT=600
# GEMINI_HTTP_TIMEOUT=600

# Local server access (optional). The server only accepts local hosts/origins
# (localhost, 127.0.0.1, [::1]); requests without Origin (curl, scripts, agents) keep working.
# Comma-separated extra hosts / origins, e.g. to open the app from a LAN tablet:
# IA_VIDEO_ALLOWED_HOSTS=192.168.1.50
# IA_VIDEO_ALLOWED_ORIGINS=http://192.168.1.50:8004
